# EmailJS — copy this file to ".env" and fill in your values.
# Get them from https://dashboard.emailjs.com/ (Account > API Keys for the public key,
# Services for the Service ID, Email Templates for the Template ID).
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
